{
  "name": "babulo-play",
  "version": "0.10.4.13",
  "private": true,
  "description": "BaBuLo Play monorepo — streaming, distribuição e promoção musical",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "start:api": "npm --workspace apps/api run start",
    "start:web": "npm --workspace apps/web run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7"
  }
}
